#!/usr/bin/env bash
set -euo pipefail

# fa - free-agents-free-models: one entry point for everything.
#
# The tool is installed ONCE per machine and put on PATH. It is NOT cloned into
# each project: credentials and learned wallet health are machine-wide, and a
# per-project copy would mean N registries to rediscover and N copies to update.
# A project gets only its routing rules and its own run journal.
#
#   fa bootstrap       FIRST RUN: build the registry, probe wallets, install skills
#   fa install-skills  put the skill cards where the agent runtimes look
#   fa init            set up the current directory (same as .free-agents/setup.sh)
#   fa lanes [-v]      how many independent credential lanes are healthy
#   fa discover        rebuild the credential registry (after adding/removing keys)
#   fa probe [--all]   prove each wallet answers
#   fa doctor          verify this machine is set up correctly
#   fa run "task"      one task, with fallback across every lane
#   fa plan "goal"     goal -> .orch/tasks.json
#   fa go "goal"       plan, then run it
#   fa status          progress of the current project
#   fa resume          continue after any interruption
#   fa update          git pull the tool
#   fa where           print install paths

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "${HERE}/.." && pwd)"
# Must match lib/common.sh: state lives inside this clone unless overridden.
STATE="${FREE_AGENTS_STATE:-${ROOT}/state}"

usage() { sed -n '6,26p' "$0" >&2; exit 3; }
cmd="${1:-}"; shift || true

case "$cmd" in
  init)
    # setup.sh owns project setup; keep `fa init` as an alias so either works.
    exec bash "${ROOT}/setup.sh" "$(pwd)"
    ;;
  bootstrap)
    # One command for an agent to run on first use: build the registry, prove the
    # wallets answer, put the skills where runtimes look, and report.
    echo "[fa] discovering credentials this machine's agents already hold..."
    "${HERE}/buckets.sh" discover || exit $?
    echo "[fa] probing wallets (proves each one actually answers)..."
    "${HERE}/buckets.sh" probe || true
    "${ROOT}/bin/fa" install-skills
    echo
    "${HERE}/buckets.sh" show
    echo
    n="$("${HERE}/buckets.sh" lanes 2>/dev/null || echo 0)"
    echo "[fa] $n healthy lane(s)."
    [[ "$n" -lt 2 ]] && echo "[fa] With fewer than 2 lanes, work directly - splitting cannot help."
    exit 0
    ;;

  install-skills)
    # Put the skill cards where the agent runtimes look for them. They are
    # symlinked, not copied, so editing one here does not leave a stale copy in
    # the project - the duplicate-copy problem this project already hit once.
    proj="$(cd "${ROOT}/.." && pwd)"
    dest="${proj}/.opencode/skills"
    mkdir -p "$dest"
    for sk in "${ROOT}"/skills/*/; do
      [[ -d "$sk" ]] || continue
      ln -sfn "$sk" "${dest}/$(basename "$sk")"
    done
    echo "[fa] skills linked into ${dest}/"
    ls "$dest" 2>/dev/null | sed 's/^/       /'
    exit 0
    ;;

  lanes)    exec "${HERE}/buckets.sh" lanes "$@" ;;
  discover) exec "${HERE}/buckets.sh" discover "$@" ;;
  probe)    exec "${HERE}/buckets.sh" probe "$@" ;;
  show)     exec "${HERE}/buckets.sh" show "$@" ;;
  run)      exec "${HERE}/run.sh" -w "$(pwd)" "$@" ;;
  plan)     exec "${HERE}/plan.sh" -w "$(pwd)" "$@" ;;
  status)   exec "${HERE}/orch.sh" status "$@" ;;
  resume)   exec "${HERE}/orch.sh" resume "$@" ;;
  orch)     exec "${HERE}/orch.sh" "$@" ;;

  go)
    [[ $# -gt 0 ]] || { echo "fa go: needs a goal" >&2; exit 3; }
    "${HERE}/plan.sh" -w "$(pwd)" "$1" || exit $?
    exec "${HERE}/orch.sh" run
    ;;

  where)
    printf 'tool:     %s\nstate:    %s\nproject:  %s\n' "$ROOT" "$STATE" "$(pwd)"
    ;;

  update)
    git -C "$ROOT" pull --ff-only && echo "updated: $(git -C "$ROOT" log --oneline -1)"
    ;;

  doctor)
    rc=0
    echo "free-agents-free-models doctor"
    printf '  tool      %s\n' "$ROOT"
    printf '  state     %s\n' "$STATE"
    echo
    echo "dependencies"
    for c in jq curl flock sqlite3 timeout; do
      if command -v "$c" >/dev/null; then printf '  ok      %s\n' "$c"
      else printf '  MISSING %s\n' "$c"; rc=1; fi
    done
    echo
    # Versions are checked because these CLIs have already changed invocation
    # shape once during this project, and a wrong call shape is indistinguishable
    # from a dead model - it fails silently as "that model is broken".
    echo "agents (verified versions in docs/SETUP.md)"
    found=0
    for a in opencode:1.17.20 kilo:7.5.5 hermes:0.20.5; do
      name="${a%%:*}"; want="${a##*:}"
      if command -v "$name" >/dev/null; then
        # `|| true` is load-bearing: grep exits 1 when an agent reports its
        # version in an unexpected format, and under `set -e` that aborted
        # doctor halfway through - silently skipping the registry check, which
        # is the one people actually rely on.
        got="$("$name" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
        if [[ "$got" == "$want" ]]; then printf '  ok      %-9s %s\n' "$name" "$got"
        else printf '  differs %-9s %s (verified against %s)\n' "$name" "${got:-unknown}" "$want"; fi
        found=$((found+1))
      else printf '  absent  %s\n' "$name"; fi
    done
    [[ $found -eq 0 ]] && { echo "  ERROR: no agent CLI installed - nothing can run"; rc=1; }
    echo
    echo "taxonomy self-test"
    if bash "${HERE}/lib/classify.sh" --self-test >/dev/null 2>&1; then echo "  ok      passes"
    else echo "  FAILED  bash bin/lib/classify.sh --self-test"; rc=1; fi
    echo
    echo "credential registry"
    if [[ -f "${STATE}/buckets.json" ]]; then
      n="$("${HERE}/buckets.sh" lanes 2>/dev/null || echo 0)"
      printf '  ok      %s healthy lane(s)\n' "$n"
      [[ "$n" -lt 1 ]] && { echo "  ERROR: no usable lane - check keys, then: fa discover && fa probe"; rc=1; }
      [[ "$n" -eq 1 ]] && echo "  note    only ONE lane: parallel work will not help; direct mode is correct"
    else
      echo "  MISSING no registry - run: fa discover && fa probe"; rc=1
    fi
    echo
    [[ $rc -eq 0 ]] && echo "READY" || echo "NOT READY (see above)"
    exit $rc
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "fa: unknown command '$cmd'" >&2; usage ;;
esac
