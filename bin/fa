#!/usr/bin/env bash
set -euo pipefail

# fa - free-agents-free-models: one entry point for everything.
#
# The tool is installed ONCE per machine and put on PATH. It is NOT cloned into
# each project: credentials and learned wallet health are machine-wide, and a
# per-project copy would mean N registries to rediscover and N copies to update.
# A project gets only its routing rules and its own run journal.
#
#   fa bootstrap       FIRST RUN: build the registry, probe wallets, install skills
#   fa refresh         same thing, run later (credentials or agents changed)
#   fa install-skills  put the skill cards where the agent runtimes look
#   fa schedule        install a daily `fa refresh` cron (auto after bootstrap)
#   fa unschedule      remove it
#   fa init            set up the current directory (same as .free-agents/setup.sh)
#   fa lanes [-v]      how many independent credential lanes are healthy
#   fa profile         per-agent/harness learned reliability (read-only)
#   fa rank [category] the ranked candidate chain for a category (read-only)
#   fa discover        rebuild the credential registry (after adding/removing keys)
#   fa probe [--all]   prove each wallet answers
#   fa doctor          verify this machine is set up correctly
#   fa run "task"      one task, with fallback across every lane
#                       --validate  run syntax check on result (fail fast)
#   fa plan "goal"     goal -> .orch/tasks.json
#                       --graph     print the task graph as an ASCII diagram
#   fa dispatch "goal" plan, then decide DIRECT vs ORCHESTRATE for real -
#                      prints a SPLIT EVALUATION line instead of a coordinator
#                      computing the gate itself. DIRECT means: read the plan
#                      that was just written and do the work yourself.
#                       --graph     print the task graph after planning
#                       --validate  validate each task after build
#                       --isolate   use git worktrees for parallel tasks (no collisions)
#   fa go "goal"       same as `fa dispatch` - the name people type instead
#   fa graph           render the current .orch/tasks.json as a diagram
#   fa status          progress of the current project
#   fa resume          continue after any interruption
#   fa update          git pull the tool
#   fa analyze         read the journal, detect cross-task patterns
#                        --learnings  same + write .orch/learnings.md
#   fa findings        things the tool noticed it handled badly
#   fa findings --note "..."   record something only you or the coordinator saw
#                        --new    only ones not yet acknowledged
#                        --issue  emit a ready-to-file GitHub issue
#                        --ack    mark all as seen
#   fa where           print install paths

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "${HERE}/.." && pwd)"
# Do NOT recompute this. Sourcing the engine's own resolution is the only way the
# two cannot drift - a lesson this project has now learned four times
# (lanes -v vs lanes, identify vs discover, setup.sh vs the engine, and this).
. "${HERE}/lib/common.sh"
STATE="$STATE_DIR"

prompt_yn() { # $1=prompt -> 0 if yes
  local ans
  read -rp "$1 [y/N] " ans
  [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]]
}

# The orchestrate-vs-direct gate, as real code instead of prose a
# coordinator LLM computes in its head. `fa go` used to call orch.sh
# unconditionally - nothing actually checked AGENTS.md's own gate before
# dispatching, so the gate existed only as an instruction to trust.
#
# Two calling shapes:
#   fa dispatch "<goal>"   plan fresh (a cold, context-less LLM call through
#                          the fallback chain), THEN decide. For a one-shot
#                          invocation with no coordinator already holding
#                          context on the goal.
#   fa dispatch            no goal: evaluate whatever is ALREADY at
#                          .orch/tasks.json. This is the one a coordinator
#                          actually wants - AGENTS.md's own Phase 1 has it
#                          write tasks.json directly, in its own already-
#                          loaded context, which is strictly cheaper than
#                          paying for plan.sh's cold re-derivation of a
#                          project the coordinator already understands.
#
# Mirrors AGENTS.md's documented gate exactly: orchestrate only when BOTH
# (1) at least one pair of tasks has no direct dependency on each other
# (plan.sh's own check_boundaries() already guarantees any such pair has
# disjoint files too, as a precondition for the plan being written at all -
# this does not need to re-check that; a hand-authored tasks.json makes the
# same promise, per AGENTS.md's own Phase 1 note that `files` is enforced,
# not documentation) and (2) fa lanes reports >= 2.
#
# complexity (plan.sh's per-task field) does not gate the DIRECT/ORCHESTRATE
# decision yet - that branch is BATCH mode, not built. When every task is
# trivial, this only surfaces a note; it still decides DIRECT/ORCHESTRATE
# the same as before, honestly, rather than pretending a third option
# exists.
cmd_dispatch() { # $@ = [--graph] [--validate] [--isolate] ["goal"]
  local graph_flag=() extra_args=() goal=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --graph)    graph_flag=("--graph"); shift ;;
      --validate) extra_args+=("--validate"); shift ;;
      --isolate)  extra_args+=("--isolate"); shift ;;
      *) goal="$1"; shift ;;
    esac
  done

  local tasks_file="${PWD}/.orch/tasks.json"
  if [[ -n "$goal" ]]; then
    "${HERE}/plan.sh" -w "$(pwd)" "${graph_flag[@]}" "$goal" || exit $?
  else
    [[ -f "$tasks_file" ]] || { echo "fa dispatch: no goal given and no plan at ${tasks_file} - either pass a goal, or write tasks.json yourself first" >&2; exit 3; }
    jq -e '.tasks | type == "array" and length > 0' "$tasks_file" >/dev/null 2>&1 \
      || { echo "fa dispatch: ${tasks_file} has no tasks" >&2; exit 3; }
    [[ ${#graph_flag[@]} -gt 0 ]] && "${HERE}/lib/graph.sh" -w "$(pwd)" "$tasks_file"
  fi

  local n lanes has_pair trivial_n decision
  n="$(jq '.tasks | length' "$tasks_file")"
  lanes="$("${HERE}/buckets.sh" lanes 2>/dev/null || echo 0)"
  has_pair="$(jq -r '
    [.tasks[] | {id, deps: (.deps // [])}] as $t
    | [ $t[] as $a | $t[] as $b
        | select($a.id != $b.id)
        | select(($a.deps | index($b.id)) == null and ($b.deps | index($a.id)) == null)
      ] | length > 0
  ' "$tasks_file")"
  trivial_n="$(jq '[.tasks[] | select((.complexity // "standard") == "trivial")] | length' "$tasks_file")"

  if [[ "$n" -le 1 || "$has_pair" != "true" || "$lanes" -lt 2 ]]; then
    decision=DIRECT
  else
    decision=ORCHESTRATE
  fi

  echo "[fa] SPLIT EVALUATION: tasks=${n}  disjoint_pair=${has_pair}  lanes=${lanes}  trivial=${trivial_n}  -> ${decision}" >&2
  if [[ "$trivial_n" -eq "$n" && "$n" -gt 1 ]]; then
    echo "[fa]   note: every task is trivial - batch dispatch (not yet implemented) would suit this better than ${decision}" >&2
  fi

  case "$decision" in
    DIRECT)
      echo "[fa] work directly: ${n} task(s), no genuine parallel split available (or fewer than 2 lanes)." >&2
      echo "[fa] plan is at ${tasks_file} - read it and do the work yourself, in this session." >&2
      exit 0
      ;;
    ORCHESTRATE)
      exec "${HERE}/orch.sh" run "${extra_args[@]}"
      ;;
  esac
}

# Anchored to the HERE= line (self-maintaining), not a magic line range - a
# fixed range here already went stale TWICE from a single-line addition each
# time (it silently cut off `fa go`'s own --graph/--validate/--isolate
# flags, then `fa where`), which is exactly the drift a hardcoded slice with
# no anchor to the content it is supposed to track produces on every edit to
# the header. NR>=6 skips the shebang/set -e lines; awk exits before ever
# printing the HERE= line itself, so the boundary tracks the header no
# matter how many lines get added to it.
usage() { awk '/^HERE=/{exit} NR>=6{print}' "$0" >&2; exit 3; }
cmd="${1:-}"; shift || true

case "$cmd" in
  init)
    # setup.sh owns project setup; keep `fa init` as an alias so either works.
    exec bash "${ROOT}/setup.sh" "$(pwd)"
    ;;
  refresh)
    # Same path as bootstrap. Named separately because "refresh" is the word
    # people look for once the thing is already set up.
    exec "${ROOT}/bin/fa" bootstrap "$@"
    ;;

  bootstrap)
    # One command for an agent to run on first use: build the registry, prove the
    # wallets answer, put the skills where runtimes look, and report.
    # Everything here dies cryptically without the system tools; say so before
    # the registry, not after.
    _miss="$(missing_deps)"
    if [[ -n "$_miss" ]]; then
      echo "[fa] missing system dependencies: $(tr '\n' ' ' <<<"$_miss")"
      if [[ "${FA_AUTO_INSTALL:-0}" == "1" ]] || prompt_yn "install them now?"; then
        if command -v apt-get >/dev/null 2>&1; then
          sudo apt-get install -y $_miss || { echo "[fa] apt install failed"; exit 3; }
        elif command -v brew >/dev/null 2>&1; then
          brew install $_miss || { echo "[fa] brew install failed"; exit 3; }
        else
          echo "[fa]   install them first, e.g.:  sudo apt-get install -y $(tr '\n' ' ' <<<"$_miss")"
          exit 3
        fi
      else
        echo "[fa]   install them first, e.g.:  sudo apt-get install -y $(tr '\n' ' ' <<<"$_miss")"
        exit 3
      fi
    fi
    echo "[fa] discovering credentials this machine's agents already hold..."
    "${HERE}/buckets.sh" discover || exit $?
    echo "[fa] probing wallets (proves each one actually answers)..."
    "${HERE}/buckets.sh" probe || true
    "${ROOT}/bin/fa" install-skills
    echo
    "${HERE}/buckets.sh" show
    echo
    n="$("${HERE}/buckets.sh" lanes 2>/dev/null || echo 0)"
    echo "[fa] $n healthy lane(s)."
    [[ "$n" -lt 2 ]] && echo "[fa] With fewer than 2 lanes, work directly - splitting cannot help."
    echo
    echo "[fa] keeping credentials current day-to-day..."
    . "${HERE}/lib/schedule.sh"
    schedule_install || true
    exit 0
    ;;

  install-skills)
    # Put the skill cards where the agent runtimes look for them. They are
    # symlinked, not copied, so editing one here does not leave a stale copy in
    # the project - the duplicate-copy problem this project already hit once.
    proj="$(cd "${ROOT}/.." && pwd)"
    dest="${proj}/.opencode/skills"
    mkdir -p "$dest"
    for sk in "${ROOT}"/skills/*/; do
      [[ -d "$sk" ]] || continue
      ln -sfn "$sk" "${dest}/$(basename "$sk")"
    done
    echo "[fa] skills linked into ${dest}/"
    ls "$dest" 2>/dev/null | sed 's/^/       /'
    exit 0
    ;;

  lanes)    exec "${HERE}/buckets.sh" lanes "$@" ;;
  schedule)    . "${HERE}/lib/schedule.sh"
               schedule_install
               exit 0 ;;
  unschedule)  . "${HERE}/lib/schedule.sh"
               schedule_uninstall
               exit 0 ;;
  discover) exec "${HERE}/buckets.sh" discover "$@" ;;
  probe)    exec "${HERE}/buckets.sh" probe "$@" ;;
  show)     exec "${HERE}/buckets.sh" show "$@" ;;
  profile)  exec "${HERE}/buckets.sh" profile "$@" ;;
  rank)
    # The ranked candidate chain for a category, read-only - exactly what
    # candidates() computes before dispatching, just without dispatching.
    # DRY_RUN_LIMIT defaults to 0 (show every candidate) here, unlike
    # run.sh --dry-run's own default of 20: the whole point of a dedicated
    # command is seeing the full ranking, not a truncated preview.
    export DRY_RUN_LIMIT="${DRY_RUN_LIMIT:-0}"
    exec "${HERE}/run.sh" -w "$(pwd)" --dry-run -c "${1:-general}"
    ;;
  run)      exec "${HERE}/run.sh" -w "$(pwd)" "$@" ;;
  plan)     exec "${HERE}/plan.sh" -w "$(pwd)" "$@" ;;

  graph)
    # Render the current task graph as an ASCII diagram
    exec "${HERE}/lib/graph.sh" -w "$(pwd)" "$@"
    ;;
  status)   exec "${HERE}/orch.sh" status "$@" ;;
  resume)   exec "${HERE}/orch.sh" resume "$@" ;;
  orch)     exec "${HERE}/orch.sh" "$@" ;;

  dispatch) cmd_dispatch "$@" ;;
  # `fa go` used to call orch.sh unconditionally, regardless of whether the
  # plan actually split into anything worth orchestrating - dispatch is now
  # the one place that decides, so go is just its name for people who type
  # that instead.
  go)       cmd_dispatch "$@" ;;

  findings)
    . "${HERE}/lib/common.sh"; . "${HERE}/lib/findings.sh"
    case "${1:-}" in
      --note)
        # Everything else here is something the tool detected about itself. This
        # is the one channel for what only a person or the coordinator can see:
        # the spec was ambiguous, the plan split the work wrong, the result
        # compiled but missed the point. No heuristic reaches those, and without
        # a way to write them down they are lost when the terminal closes.
        [[ -n "${2:-}" ]] || { echo "fa findings --note \"what went wrong\" [detail...] [key=value ...]" >&2; exit 3; }
        note="$2"; shift 2
        # Anything shaped like key=value becomes a structured field (so `task=t3`
        # groups and filters like the automatic findings do); the rest is prose.
        detail=""; kv=()
        for a in "$@"; do
          case "$a" in
            [a-z_]*=*) kv+=("$a") ;;
            *) detail+="${detail:+ }$a" ;;
          esac
        done
        record_finding note "$note" "${detail:-no further detail}" \
          "source=manual" ${kv+"${kv[@]}"}
        echo "[fa] noted. See it with: fa findings"
        ;;
      --issue) findings_issue "${2:-all}" ;;
      --ack)   findings_ack; echo "[fa] findings marked as seen" ;;
      --new)   findings_show new ;;
      --count) findings_count "${2:-all}" ;;
      *)       findings_show all
               n="$(findings_count all)"
               [[ "${n:-0}" -gt 0 ]] && {
                 echo "To turn one into an issue:  fa findings --issue"
                 echo "To dismiss them:            fa findings --ack"; } ;;
    esac
    exit 0
    ;;

  analyze)
    . "${HERE}/lib/common.sh"; . "${HERE}/lib/findings.sh"; . "${HERE}/lib/analyze.sh"
    case "${1:-}" in
      --learnings)
        analyze_journal
        write_learnings
        ;;
      *)
        analyze_journal
        echo
        echo "Review with: fa findings"
        ;;
    esac
    exit 0
    ;;

  where)
    printf 'tool:     %s\nstate:    %s\nproject:  %s\n' "$ROOT" "$STATE" "$(pwd)"
    ;;

  update)
    git -C "$ROOT" pull --ff-only && echo "updated: $(git -C "$ROOT" log --oneline -1)"
    ;;

  doctor)
    rc=0
    echo "free-agents-free-models doctor"
    printf '  tool      %s\n' "$ROOT"
    printf '  state     %s\n' "$STATE"
    echo
    echo "dependencies"
    for c in "${REQUIRED_DEPS[@]}"; do
      if command -v "$c" >/dev/null; then printf '  ok      %s\n' "$c"
      else printf '  MISSING %s\n' "$c"; rc=1; fi
    done
    echo
    # Versions are checked because these CLIs have already changed invocation
    # shape once during this project, and a wrong call shape is indistinguishable
    # from a dead model - it fails silently as "that model is broken". The rota
    # and the pins come from the adapter list, so a harness added there is
    # version-checked without another edit. METERED lanes (copilot, cursor) are
    # now pinned too - they have real invocation shapes and spend-real allowance.
    echo "harnesses (${FA_AGENTS[*]})"
    found=0
    for a in "${FA_AGENTS[@]}"; do
      bin="$(adapter_field "$a" VERSION_BIN)"
      want="$(adapter_field "$a" VERIFIED_VERSION)"
      met="$( [[ "$(adapter_metered "$a")" == "1" ]] && echo " (metered)" || true )"
      if adapter_installed "$a"; then
        # `|| true` is load-bearing: grep exits 1 when an agent reports its
        # version in an unexpected format, and under `set -e` that aborted
        # doctor halfway through - silently skipping the registry check, which
        # is the one people actually rely on.
        got="$("$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
        if [[ "$got" == "$want" ]]; then printf '  ok      %-9s %s%s\n' "$a" "$got" "$met"
        else printf '  differs %-9s %s (verified against %s)%s\n' "$a" "${got:-unknown}" "$want" "$met"; fi
        found=$((found+1))
      else printf '  absent  %s%s\n' "$a" "$met"; fi
    done
    [[ $found -eq 0 ]] && { echo "  ERROR: no agent CLI installed - nothing can run"; rc=1; }
    echo
    echo "harnesses installed without an adapter (visible, never schedulable)"
    unad="$(adapters_present_without_adapter || true)"
    if [[ -z "$unad" ]]; then
      printf '  ok      none\n'
    else
      printf '  note    installed but not a lane: %s (no adapter - can never run)\n' \
        "$(tr '\n' ' ' <<<"$unad")"
    fi
    echo
    echo "taxonomy self-test"
    if bash "${HERE}/lib/classify.sh" --self-test >/dev/null 2>&1; then echo "  ok      passes"
    else echo "  FAILED  bash bin/lib/classify.sh --self-test"; rc=1; fi
    echo
    echo "credential registry"
    case "$(registry_status)" in
      missing)
        echo "  MISSING no registry - run: fa bootstrap"; rc=1 ;;
      stale:credentials)
        echo "  STALE   your credentials changed since the registry was built."
        echo "          a key you added is invisible until: fa refresh"; rc=1 ;;
      stale:new-agent)
        echo "  STALE   an agent is installed with no lane yet - run: fa refresh"; rc=1 ;;
      aged:*)
        printf '  note    %s lane(s), %s days old - refresh when convenient: fa refresh\n' \
          "$("${HERE}/buckets.sh" lanes 2>/dev/null || echo 0)" "$(registry_age_days)" ;;
      *)
        n="$("${HERE}/buckets.sh" lanes 2>/dev/null || echo 0)"
        printf '  ok      %s healthy lane(s), %s days old, credentials unchanged\n' \
          "$n" "$(registry_age_days)"
        [[ "$n" -lt 1 ]] && { echo "  ERROR: no usable lane - check keys, then: fa refresh"; rc=1; }
        [[ "$n" -eq 1 ]] && echo "  note    only ONE lane: parallel work will not help; direct mode is correct" ;;
    esac
    echo
    echo "findings"
    ( . "${HERE}/lib/common.sh"; . "${HERE}/lib/findings.sh"
      n="$(findings_count all)"; nn="$(findings_count new)"
      if [[ "${n:-0}" -eq 0 ]]; then echo "  ok      nothing noted"
      else printf '  note    %s finding(s), %s unseen - run: fa findings\n' "$n" "$nn"; fi )
    echo
    [[ $rc -eq 0 ]] && echo "READY" || echo "NOT READY (see above)"
    exit $rc
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "fa: unknown command '$cmd'" >&2; usage ;;
esac
