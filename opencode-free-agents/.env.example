# ============================================================================
# opencode-free-agents - environment template
# Copy to one of these locations (first match wins) and fill in:
#   1. <project-root>/.env          (recommended; add ".env" to .gitignore)
#   2. <skill-folder>/.env
#   3. ~/.config/opencode-free-agents/.env  (machine-global)
#
# If NO .env is found anywhere, bootstrap.sh continues with whatever
# credentials already exist in ~/.local/share/opencode/auth.json.
# Never commit real keys. Keep this file committed instead.
# ============================================================================

# --- Known providers (alias -> opencode provider id) ------------------------
# Any models.dev provider works this way: <PROVIDER>_API_KEY where the alias
# maps to its catalog id (openrouter, freemodel, anthropic, openai, groq,
# deepseek, nvidia, together-ai, ...). Unknown aliases fall back to generic
# PROVIDER_N blocks below.

OPENROUTER_API_KEY=
FREEMODEL_API_KEY=
KILO_GATEWAY_API_KEY=

# OpenCode Zen free models work WITHOUT a key on most accounts.
# Set only if you created a Zen API key (https://opencode.ai/auth):
# OPENCODE_ZEN_API_KEY=

# --- Generic blocks for ANY provider (repeat with 1,2,3...) -----------------
# Use when the alias above does not exist or you run a custom endpoint.
#
# PROVIDER_1_ID=my-free-provider
# PROVIDER_1_KEY=xxxx
# PROVIDER_1_TYPE=api
# PROVIDER_1_BASEURL=https://api.example.com/v1   # optional custom endpoint

# --- Behavior flags (optional) ----------------------------------------------
# OC_SKIP_REFRESH=1        # bootstrap: skip first refresh after merging keys
