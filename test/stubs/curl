#!/usr/bin/env bash
# Stub curl: returns canned OpenRouter models metadata for the models endpoint,
# nothing otherwise. Lets discover.sh run fully offline & deterministically.
for a in "$@"; do
  if [[ "$a" == *"openrouter.ai/api/v1/models"* ]]; then
    cat <<'JSON'
{"data":[
  {"id":"openai/gpt-4o","context_length":128000,"pricing":{"prompt":"0","completion":"0"}},
  {"id":"anthropic/claude-3.5-sonnet","context_length":200000,"pricing":{"prompt":"1","completion":"1"}}
]}
JSON
    exit 0
  fi
done
exit 0
