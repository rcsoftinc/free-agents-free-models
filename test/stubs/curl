#!/usr/bin/env bash
# Stub curl: returns canned OpenRouter models metadata for the models endpoint,
# plays a vendor's install script for the URLs a suite tables, nothing otherwise.
# Lets discover.sh and setup.sh run fully offline & deterministically.
# Honour -o FILE like the real curl. Without this, callers that redirect to a
# file (buckets.sh and find-free-providers.sh both do) see an empty download and
# take their error path, which looks exactly like a network failure.
#
# CURL_STUB_LOG: when set, every call appends one line (the arguments), so a
# suite can assert the exact command a caller ran - bin/lib/install.sh must run
# `-fsSL <url>` and nothing else. Separate from STUB_LOG, which counts agent
# invocations and must not grow by curl calls.
[[ -n "${CURL_STUB_LOG:-}" ]] && printf 'curl %s\n' "$*" >> "$CURL_STUB_LOG"

OUT=""
prev=""
for a in "$@"; do
  [[ "$prev" == "-o" ]] && OUT="$a"
  prev="$a"
done
emit() { if [[ -n "$OUT" ]]; then cat > "$OUT"; else cat; fi; }

# A vendor's install script (bin/lib/install.sh runs `curl -fsSL URL | bash`).
# STUB_INSTALL_TABLE is a file the suite writes, one `url<TAB>binary<TAB>bindir`
# per line read FROM the adapters, so this stub never holds a second copy of the
# URLs. The script played copies this directory's stub for that binary into
# $HOME/<bindir> - where the real script puts the real binary - and leaves a
# receipt naming the shell it ran under (bash, or empty for sh).
# STUB_INSTALL_FAIL names binaries whose script fails; STUB_INSTALL_NOOP, those
# whose script exits 0 having installed nothing.
if [[ -n "${STUB_INSTALL_TABLE:-}" && -f "$STUB_INSTALL_TABLE" ]]; then
  url=""
  for a in "$@"; do [[ "$a" == http* ]] && url="$a"; done
  row="$(awk -F'\t' -v u="$url" '$1 == u { print; exit }' "$STUB_INSTALL_TABLE")"
  if [[ -n "$row" ]]; then
    bin="$(cut -f2 <<<"$row")"; bindir="$(cut -f3 <<<"$row")"
    stubs="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
    if [[ " ${STUB_INSTALL_FAIL:-} " == *" $bin "* ]]; then
      emit <<'SH'
echo "stub installer: download failed" >&2
exit 1
SH
    elif [[ " ${STUB_INSTALL_NOOP:-} " == *" $bin "* ]]; then
      emit <<'SH'
echo "stub installer: nothing to do"
exit 0
SH
    else
      emit <<SH
mkdir -p "\$HOME/$bindir"
cp "$stubs/$bin" "\$HOME/$bindir/$bin"
chmod +x "\$HOME/$bindir/$bin"
printf '%s\n' "\${BASH_VERSION:+bash}" > "\$HOME/.stub-installer-shell.$bin"
SH
    fi
    exit 0
  fi
fi

for a in "$@"; do
  # models.dev catalogue, for find-free-providers.sh. Two providers with free
  # models (different counts and context sizes, so ranking is observable) and one
  # with none, which must not appear at all.
  if [[ "$a" == *"models.dev/api.json"* ]]; then
    emit <<'JSON'
{
  "alpha": { "name": "Alpha Labs", "env": ["ALPHA_API_KEY"], "models": {
      "a-1": { "cost": {"input": 0, "output": 0}, "limit": {"context": 128000} },
      "a-2": { "cost": {"input": 0, "output": 0}, "limit": {"context": 32000} },
      "a-3": { "cost": {"input": 5, "output": 5}, "limit": {"context": 200000} } } },
  "beta":  { "name": "Beta Systems", "env": ["BETA_API_KEY"], "models": {
      "b-1": { "cost": {"input": 0, "output": 0}, "limit": {"context": 1000000} } } },
  "gamma": { "name": "Gamma Only Paid", "env": ["GAMMA_API_KEY"], "models": {
      "g-1": { "cost": {"input": 2, "output": 2}, "limit": {"context": 8000} } } }
}
JSON
    exit 0
  fi
  if [[ "$a" == *"openrouter.ai/api/v1/models"* ]]; then
    emit <<'JSON'
{"data":[
  {"id":"openai/gpt-4o","context_length":128000,"pricing":{"prompt":"0","completion":"0"}},
  {"id":"anthropic/claude-3.5-sonnet","context_length":200000,"pricing":{"prompt":"1","completion":"1"}}
]}
JSON
    exit 0
  fi
  # lib/quota.sh's live check. STUB_QUOTA_MODE picks the canned response so a
  # test can exercise both the happy path and "endpoint returned garbage"
  # without touching the network.
  if [[ "$a" == *"openrouter.ai/api/v1/auth/key"* ]]; then
    case "${STUB_QUOTA_MODE:-ok}" in
      ok)
        emit <<'JSON'
{"data":{"label":"test-key","usage":1.5,"limit":null,"limit_remaining":null,
         "is_free_tier":true,"rate_limit":{"requests":20,"interval":"10s"}}}
JSON
        ;;
      malformed) emit <<<'not json' ;;
      *) emit <<<'{}' ;;
    esac
    exit 0
  fi
done
exit 0
