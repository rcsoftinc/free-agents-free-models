#!/usr/bin/env bash
# Stub herdr for offline testing of what background jobs show in herdr. Never talks
# to a herdr server: every call is appended, one line of arguments, to
# $HERDR_STUB_LOG, and the answers below are what herdr 0.9.5 returns for the
# commands fa uses. A job's tab is always wT:t9 with pane wT:p9; a dispatch task's
# is named for the task, so `api` gets wT:t_api and wT:p_api.
#   HERDR_STUB_FAIL=1             every command fails, as with a dead server
#   HERDR_STUB_HANG=N             every command hangs N seconds first
[[ -n "${HERDR_STUB_LOG:-}" ]] && printf '%s\n' "$*" >> "$HERDR_STUB_LOG"
[[ -n "${HERDR_STUB_HANG:-}" ]] && sleep "$HERDR_STUB_HANG"
if [[ "${HERDR_STUB_FAIL:-0}" == 1 ]]; then
  echo '{"error":{"code":"server_unavailable","message":"stub: no server"}}' >&2
  exit 1
fi
case "${1:-} ${2:-}" in
  "tab create")
    label=""; prev=""
    for a in "$@"; do [[ "$prev" == --label ]] && label="$a"; prev="$a"; done
    case "${label#fa }" in j[0-9]*) n=9 ;; *) n="_${label#fa }" ;; esac
    printf '{"id":"cli:tab:create","result":{"root_pane":{"pane_id":"wT:p%s","focused":false},"tab":{"tab_id":"wT:t%s","focused":false}},"type":"tab_created"}\n' "$n" "$n" ;;
  *)
    printf '{"id":"cli:stub","result":{}}\n' ;;
esac
exit 0
